FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2

WORKDIR /app

# torch CPU 轮子依赖 libgomp；不安装 CUDA 运行时，避免镜像和内存膨胀。
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.14.1

RUN pip install --no-cache-dir \
        sentence-transformers==6.2.0 \
        fastapi==0.161.1 \
        uvicorn==0.54.0 \
        pydantic==2.14.1 \
        numpy==2.5.4

COPY scripts/embed_server.py /app/scripts/embed_server.py

EXPOSE 8010

CMD ["uvicorn", "scripts.embed_server:app", "--host", "0.0.0.0", "--port", "8010"]
