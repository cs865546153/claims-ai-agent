# 默认真实模式；demo只使用明确标记的合成数据，不执行外部支付或通知。
APP_ENV=development
# 日志：默认同时输出 stderr；设置 LOG_FILE 后追加写入文件，父目录会自动创建。
# 生产容器建议只输出 stdout/stderr 交给采集器；裸机/本地开发可落盘。
LOG_LEVEL=INFO
LOG_FILE=.data/logs/app.log
# 单文件上限与保留份数；LOG_MAX_BYTES=0 关闭轮转
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# LOG_JSON=true
BUSINESS_MODE=real
MODEL_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_API_KEY=EMPTY
LOCAL_FAST_MODEL=Qwen2.5-14B-Instruct
LOCAL_MAIN_MODEL=Qwen2.5-32B-Instruct
LOCAL_PRO_MODEL=Qwen2.5-72B-Instruct
LOCAL_VISION_MODEL=Qwen2.5-VL-7B-Instruct
LOCAL_LLM_MODEL=Qwen2.5-72B-Instruct
# DeepSeek 为可选模式；MODEL_PROVIDER=deepseek时才使用以下凭证。
# 接口为 OpenAI 兼容，deepseek-flash 支持视觉与JSON输出，deepseek-v4-pro 不支持视觉。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=false
# 百炼为可选模式；MODEL_PROVIDER=bailian时才使用以下凭证。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
QWEN_PLUS_MODEL=qwen-plus
QWEN_MAX_MODEL=qwen-max
QWEN_FLASH_MODEL=qwen-flash
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=EMPTY
# 远程/容器 Milvus
MILVUS_URI=http://127.0.0.1:19530
# 本地 macOS/Linux 可改用嵌入式 Milvus Lite（无需 Docker）；设置后覆盖 MILVUS_URI：
# VECTOR_STORE_URI=./.data/milvus.db
# 投资知识库 RAG：Wiki 走 BM25 + 元数据 + BGE-M3/Milvus 三路召回，RRF 后 BGE-Reranker 精排；不可用时自动降级。
INVESTMENT_RAG_ENABLED=true
INVESTMENT_RAG_COLLECTION=investment_wiki
INVESTMENT_RAG_TOP_K=4
# 通用知识库 RAG：目录内 Markdown/TXT/PDF/DOCX/HTML 自动切分，按 domain 懒加载。
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_BASE_DIR=data/knowledge_base
KNOWLEDGE_RAG_COLLECTION=knowledge_general
KNOWLEDGE_RAG_TOP_K=5
# 多路召回候选倍数 + rerank；BM25 是召回线，BGE-Reranker 才是精排。
RAG_CANDIDATE_MULTIPLIER=4
RERANK_ENABLED=true
RERANK_BASE_URL=http://127.0.0.1:8010/v1
RERANK_MODEL=bge-reranker-base
RERANK_TIMEOUT=10.0
# 同时作为进入 Cross-Encoder 的候选池上限（与 RRF 融合候选数取较小值）
RERANK_TOP_N=20
# 失败后的冷却秒数；期间直接走词项重排，到期自动重试
RERANK_RETRY_COOLDOWN=60
# scripts/embed_server.py 读取的 reranker 权重路径（主项目不读取）
BGE_RERANKER_MODEL_PATH=models/bge-reranker-base
REDIS_URL=redis://127.0.0.1:6379/0
# 材料定义的HTTP保单接口；其余业务需注册组织内适配器。
CORE_QUERY_URL=
CORE_QUERY_ACCOUNT=
CORE_QUERY_PASSWORD=
# 自托管追踪：启用前创建项目并填写真实key。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 独立LangFuse Compose需要另外生成三个随机值。
LANGFUSE_DB_PASSWORD=
LANGFUSE_AUTH_SECRET=
LANGFUSE_SALT=
CLAIMS_API_KEY=
REVIEWER_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 意图路由：默认 shadow = LLM 主路由 + JEV 影子（只记录不生效）。
# 可选 jev / hybrid / llm；INTENT_* 留空时使用对应预设，填 none 表示关闭该角色。
INTENT_ENGINE=shadow
INTENT_PRIMARY=
INTENT_FALLBACK=
INTENT_SHADOW=
INTENT_CONFIDENCE_THRESHOLD=0.8
INTENT_MARGIN_THRESHOLD=0.2
INTENT_TRANSLATE_TO_ENGLISH=false
# JEV 意图识别服务；密钥只放环境变量，不要提交或写入镜像。
JEV_BASE_URL=https://tokendance.space/gateway/typesafe/v1/systemone
JEV_API_KEY=
JEV_MODEL=ateve-jev-v1
JEV_TIMEOUT_S=10
# 领域清单路径；留空使用 configs/domains.yaml。
DOMAINS_CONFIG=
