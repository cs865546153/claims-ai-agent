# 复制为 .env 后填写。此文件是 shell 语法，不会由 SkillOpt 自动加载。
# Base URL 请按服务商说明填写，不包含 /chat/completions。

# ── 通用配置（两个角色未单独设置时的回退值） ──
OPENAI_COMPATIBLE_BASE_URL='https://your-provider.example/v1'
OPENAI_COMPATIBLE_MODEL='YOUR_MODEL_ID'
OPENAI_COMPATIBLE_API_KEY=''
OPENAI_COMPATIBLE_MAX_TOKENS=4096
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=120

# ── Target 模型（做题 / 评估用） ──
# 未设置时回退到上面的通用值；如果 target 使用不同的服务商，取消注释并填写。
# TARGET_OPENAI_COMPATIBLE_BASE_URL=''
# TARGET_OPENAI_COMPATIBLE_MODEL=''
# TARGET_OPENAI_COMPATIBLE_API_KEY=''

# ── Optimizer 模型（优化 Skill 用，通常需要更强的推理能力） ──
# 未设置时回退到上面的通用值；如果 optimizer 使用不同的服务商，取消注释并填写。
# OPTIMIZER_OPENAI_COMPATIBLE_BASE_URL=''
# OPTIMIZER_OPENAI_COMPATIBLE_MODEL=''
# OPTIMIZER_OPENAI_COMPATIBLE_API_KEY=''
